{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/:path*", "destination": "/frontend/:path*" },
    { "source": "/sw.js", "destination": "/frontend/sw.js" },
    { "source": "/", "destination": "/frontend/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }]
    }
  ]
}
